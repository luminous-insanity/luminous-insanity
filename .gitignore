# Python
*.pyc
*.pyo
__pycache__/

# Virtual environment and editor files
.venv/
venv/
.idea/

# Django
*.log
*.sqlite3
db.sqlite3

# Environment files (secrets)
.env

# Collected static files. collectstatic creates these; never commit them.
# (Your own CSS lives in /static/ and MUST be committed, so don't ignore that folder.)
/staticfiles/

# Rate-limit counters and database backups
.ratelimit_cache/
backups/

# App binaries and signing material (never commit; upload to the server directly)
*.apk
*.aab
*.keystore
*.jks
*.pem
*.key